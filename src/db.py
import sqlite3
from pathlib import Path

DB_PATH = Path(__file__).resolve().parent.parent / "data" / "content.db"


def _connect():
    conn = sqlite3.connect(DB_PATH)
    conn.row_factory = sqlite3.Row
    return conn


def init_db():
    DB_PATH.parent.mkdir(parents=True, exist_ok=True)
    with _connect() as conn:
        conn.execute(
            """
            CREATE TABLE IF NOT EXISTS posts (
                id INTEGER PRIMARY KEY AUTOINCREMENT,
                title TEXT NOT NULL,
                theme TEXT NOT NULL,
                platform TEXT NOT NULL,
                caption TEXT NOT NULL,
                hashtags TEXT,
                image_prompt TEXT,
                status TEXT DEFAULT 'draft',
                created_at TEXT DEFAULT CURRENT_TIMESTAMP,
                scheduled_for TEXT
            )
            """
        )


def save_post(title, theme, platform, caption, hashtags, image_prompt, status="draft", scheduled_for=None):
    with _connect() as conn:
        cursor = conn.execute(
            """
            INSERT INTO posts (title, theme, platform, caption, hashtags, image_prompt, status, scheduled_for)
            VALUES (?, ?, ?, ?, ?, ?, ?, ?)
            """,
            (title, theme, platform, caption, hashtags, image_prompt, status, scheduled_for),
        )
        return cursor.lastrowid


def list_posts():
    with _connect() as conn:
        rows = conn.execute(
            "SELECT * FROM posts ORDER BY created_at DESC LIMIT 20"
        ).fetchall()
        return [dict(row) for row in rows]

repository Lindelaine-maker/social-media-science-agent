from flask import Flask, jsonify, render_template, request

from src.content_generator import ContentGenerator
from src.db import init_db, list_posts, save_post


app = Flask(__name__)
app.config["SECRET_KEY"] = "science-social-agent-secret"

init_db()
generator = ContentGenerator()


@app.route("/", methods=["GET", "POST"])
def index():
    content = None
    if request.method == "POST":
        theme = request.form.get("theme", "ciência e tecnologia")
        platform = request.form.get("platform", "instagram")
        content = generator.generate(theme, platform)
        save_post(
            title=content["title"],
            theme=content["theme"],
            platform=content["platform"],
            caption=content["caption"],
            hashtags=", ".join(content["hashtags"]),
            image_prompt=content["image_prompt"],
            status="draft",
        )

    posts = list_posts()
    return render_template("index.html", content=content, posts=posts)


@app.route("/api/generate", methods=["POST"])
def api_generate():
    data = request.get_json() or {}
    theme = data.get("theme", "ciência e tecnologia")
    platform = data.get("platform", "instagram")

    content = generator.generate(theme, platform)
    save_post(
        title=content["title"],
        theme=content["theme"],
        platform=content["platform"],
        caption=content["caption"],
        hashtags=", ".join(content["hashtags"]),
        image_prompt=content["image_prompt"],
        status="draft",
    )

    return jsonify({"success": True, "content": content})


if __name__ == "__main__":
    app.run(host="0.0.0.0", port=5000, debug=True)
